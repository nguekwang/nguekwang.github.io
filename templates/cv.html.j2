<!doctype html>
{#- Printable CV for one language. tools/build.py renders it and prints it to PDF with headless Chrome.
    It shows only what the profile page already shows; never add details that are not on the page. -#}
<html lang="{{ code }}" dir="{{ t.dir }}">
<head>
<meta charset="utf-8">
{% with policy = "cv" %}{% include "security.html.j2" %}{% endwith %}
<title>{{ t.cv_h }} – {{ h1 }}</title>
<meta name="author" content="{{ site.name.latin_short }}">
<link rel="stylesheet" href="cv.css">
</head>
<body>
<header>
  <p class="doc">{{ t.cv_h }}</p>
  <h1>{{ h1 }}</h1>
  <p class="alt" lang="{{ alt_lang }}">{{ alt_name }}</p>
  <ul class="contact">
    <li><span>{{ t.email }}{{ t.colon }}</span><bdi dir="ltr">{{ site.email }}</bdi></li>
    <li><span>{{ t.website }}{{ t.colon }}</span><bdi dir="ltr">{{ site.url | replace("https://", "") }}/{{ code }}/</bdi></li>
    <li><span>GitHub{{ t.colon }}</span><bdi dir="ltr">{{ site.github | replace("https://", "") }}</bdi></li>
  </ul>
  {% if notice %}<p class="mt">{{ notice }}</p>{% endif %}
</header>

<h2>{{ t.interests_h }}</h2>
<ul>{% for x in t.interests %}<li>{{ x }}</li>{% endfor %}</ul>

<h2>{{ t.current_h }}</h2>
<p>{{ t.current }}</p>

<h2>{{ t.pubs_h }}</h2>
<ul>
  {% for x in talks %}<li><bdi dir="ltr">{{ x.date }}</bdi> {{ x.title }}, {{ x.venue }}</li>{% endfor %}
  {% for p in pubs %}<li><bdi dir="auto" lang="{{ p.lang }}">{{ p.title }}</bdi>{% if p.title_en %}{{ p.en_space }}<bdi dir="ltr">{{ p.en_open }}<span lang="en">{{ p.title_en }}</span>{{ p.en_after }}</bdi>{% endif %}{{ p.note }}</li>{% endfor %}
</ul>

<h2>{{ t.projects_h }}</h2>
<ul>{% for p in t.projects %}<li><strong>{% if p.name in project_sites %}<a href="{{ project_sites[p.name] }}">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</strong>{{ t.colon }}{{ p.desc }}</li>{% endfor %}</ul>

<h2>{{ t.outlook_h }}</h2>
<ul>{% for x in t.outlook %}<li><strong>{{ x.name }}</strong>{{ t.colon }}{{ x.desc }}</li>{% endfor %}</ul>

<h2>{{ t.career_h }}</h2>
<ul>{% for x in t.career %}<li>{{ x }}</li>{% endfor %}</ul>

<h2>{{ t.langs_h }}</h2>
<ul>{% for g in t.langs %}<li><strong>{{ g.label }}</strong>{{ t.colon }}{% for x in g['items'] %}{{ x }}{% if not loop.last %} · {% endif %}{% endfor %}</li>{% endfor %}</ul>

<h2>{{ t.keywords_h }}</h2>
<ul class="keywords">{% for g in site.keywords %}<li><strong>{{ t.keyword_groups[g.group] }}</strong>{{ t.colon }}{% for k in g['items'] %}{{ t.keywords[k] }}{% if not loop.last %} · {% endif %}{% endfor %}</li>{% endfor %}</ul>

<footer>{{ updated }} · <bdi dir="ltr">{{ site.url | replace("https://", "") }}/{{ code }}/</bdi></footer>
</body>
</html>
