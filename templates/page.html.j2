<!doctype html>
<html lang="{{ code }}" dir="{{ t.dir }}">
<head>
<meta charset="utf-8">
{% include "csp.html.j2" %}
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ t.desc }}">
<meta name="author" content="{{ site.name.latin_short }}">
{% include "robots.html.j2" -%}
{% include "verification.html.j2" %}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ site_name }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ t.desc }}">
<meta property="og:url" content="{{ site.url }}/{{ code }}/">
<meta property="og:locale" content="{{ t.og_locale }}">
{% for o in langs if o.code != code %}<meta property="og:locale:alternate" content="{{ o.og_locale }}">
{% endfor %}<meta property="profile:first_name" content="{{ site.name.given }}">
<meta property="profile:last_name" content="{{ site.name.family }}">
<meta name="twitter:card" content="summary">
<link rel="canonical" href="{{ site.url }}/{{ code }}/">
{% for o in langs %}<link rel="alternate" hreflang="{{ o.code }}" href="{{ site.url }}/{{ o.code }}/">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
<link rel="stylesheet" href="../style.css">
<script src="../theme.js"></script>
<script type="application/ld+json">{{ jsonld }}</script>
</head>
<body>
<main>
  <nav><button type="button" class="theme-toggle" aria-pressed="false" aria-label="{{ t.theme_dark }}" title="{{ t.theme_dark }}"><svg class="moon" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5z"/></svg><svg class="sun" viewBox="0 0 24 24" width="16" height="16" aria-hidden="true" focusable="false"><circle cx="12" cy="12" r="4.5"/><path d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"/></svg></button><details class="langmenu">
      <summary>{{ t.native }}</summary>
      <div class="panel">
        <ul>{% for o in langs %}{% if o.code == code %}<li><span lang="{{ o.code }}">{{ o.native }}</span></li>{% else %}<li><a href="../{{ o.code }}/" lang="{{ o.code }}" hreflang="{{ o.code }}">{{ o.native }}</a></li>{% endif %}{% endfor %}</ul>
        <a class="req" href="{{ request_mailto }}" data-cv="request-lang">{{ t.request }}</a>
      </div>
    </details></nav>
  {% if notice %}<p class="mt">{{ notice }}</p>{% endif %}
  <header>
    <h1>{{ h1 }}</h1>
    <p class="alt" lang="{{ alt_lang }}">{{ alt_name }}</p>
    <p class="buttons"><a class="btn" href="mailto:{{ site.email }}" data-cv="email-top">{{ t.btn_email }}</a><a class="btn ghost" href="{{ site.github }}" data-cv="github-top">{{ t.btn_github }}</a><a class="btn ghost" href="{{ site.cv_file }}" type="application/pdf" data-cv="cv-top">{{ t.btn_cv }}</a></p>
  </header>
  <section lang="{{ code }}">
    <h2>{{ t.interests_h }}</h2>
    <ul>{% for x in t.interests %}<li>{{ x }}</li>{% endfor %}</ul>
  </section>

  <section class="kw">
    <h2>{{ t.keywords_h }}</h2>
    <dl class="kw-groups">{% for g in site.keywords %}
      <dt>{{ t.keyword_groups[g.group] }}</dt><dd><ul class="keywords">{% for k in g['items'] %}<li>{{ t.keywords[k] }}</li>{% endfor %}</ul></dd>{% endfor %}
    </dl>
  </section>
{% if talks %}  <section class="talks"><div class="carousel">{% for x in talks %}<a class="talk"{% if x.url %} href="{{ x.url }}" data-cv="talk"{% endif %}><span class="meta">{{ x.date }} / {{ x.venue }}</span><strong>{{ x.title }}</strong></a>{% endfor %}</div></section>
{% endif %}

  <section lang="{{ code }}">
    <h2>{{ t.current_h }}</h2>
    <p>{{ t.current }}</p>
  </section>

  <section>
    <h2>{{ t.pubs_h }}</h2>
    <ul>
      {% for p in pubs %}<li><bdi dir="auto" lang="{{ p.lang }}">{{ p.title }}</bdi>{% if p.title_en %}{{ p.en_space }}<bdi dir="ltr">{{ p.en_open }}<span lang="en">{{ p.title_en }}</span>{{ p.en_after }}</bdi>{% endif %}{{ p.note }}</li>{% endfor %}
    </ul>
  </section>

  <section lang="{{ code }}">
    <h2>{{ t.projects_h }}</h2>
    <ul>{% for p in t.projects %}<li><strong>{% if p.name in project_sites %}<a href="{{ project_sites[p.name] }}" data-cv="project-site">{{ p.name }}</a>{% else %}{{ p.name }}{% endif %}</strong>{{ t.colon }}{{ p.desc }}{% if p.name in ai_pages %}<br><span class="meta">{% set h = t.ai_tools_h.split("{project}") %}<a href="{{ ai_pages[p.name].path }}/">{{ h[0] }}<bdi>{{ p.name }}</bdi>{{ h[1] }}</a></span>{% endif %}</li>{% endfor %}</ul>
  </section>

  <section lang="{{ code }}">
    <h2>{{ t.outlook_h }}</h2>
    <ul>{% for x in t.outlook %}<li><strong>{{ x.name }}</strong>{{ t.colon }}{{ x.desc }}</li>{% endfor %}</ul>
  </section>

  <section>
    <h2>{{ t.career_h }}</h2>
    <ul>{% for x in t.career %}<li>{{ x }}</li>{% endfor %}</ul>
    <p class="note-link"><a href="{{ names_slug }}/">{{ t.names_h }}</a></p>
  </section>

  <section lang="{{ code }}">
    <h2>{{ t.langs_h }}</h2>
    <dl class="langs">{% for g in t.langs %}
      <dt>{{ g.label }}</dt><dd><ul>{% for x in g['items'] %}<li>{{ x }}</li>{% endfor %}</ul></dd>{% endfor %}
    </dl>
  </section>

  <section>
    <h2>{{ t.contact_h }}</h2>
    <dl class="contact">
      <dt>{{ t.email }}</dt><dd><a href="mailto:{{ site.email }}" dir="ltr" data-cv="email-contact">{{ site.email }}</a></dd>
      <dt>GitHub</dt><dd><a href="{{ site.github }}" dir="ltr" data-cv="github-contact">{{ site.github | replace("https://", "") }}</a></dd>
    </dl>
  </section>

  <footer>{% if updated_url %}<a href="{{ updated_url }}" class="updated">{{ updated }}</a>{% else %}{{ updated }}{% endif %}<br><small><bdi dir="ltr">&copy; {{ copyright_from }}<span class="range-dash">–</span></bdi> {{ footer_name }}</small></footer>
</main>
<script src="../lang.js"></script>
<script src="../cv.js"></script>
<script data-goatcounter="{{ site.goatcounter }}" async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
