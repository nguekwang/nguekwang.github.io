<!doctype html>
<html lang="{{ code }}" dir="{{ t.dir }}">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self' https://gc.zgo.at; img-src 'self' https://nguekwang.goatcounter.com; connect-src https://nguekwang.goatcounter.com; form-action 'none'; base-uri 'none'; object-src 'none'">
<meta name="referrer" content="strict-origin-when-cross-origin">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}</title>
<meta name="description" content="{{ t.desc }}">
<meta name="author" content="{{ site.name.latin_short }}">
{% include "verification.html.j2" %}
<meta property="og:type" content="profile">
<meta property="og:site_name" content="{{ site.name.latin }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ t.desc }}">
<meta property="og:url" content="{{ site.url }}/{{ code }}/">
<meta property="profile:first_name" content="{{ site.name.given }}">
<meta property="profile:last_name" content="{{ site.name.family }}">
<meta name="twitter:card" content="summary">
<link rel="canonical" href="{{ site.url }}/{{ code }}/">
{% for o in langs %}<link rel="alternate" hreflang="{{ o.code }}" href="{{ site.url }}/{{ o.code }}/">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
<link rel="stylesheet" href="../style.css">
<script type="application/ld+json">{{ jsonld }}</script>
</head>
<body>
<main>
  <nav><details class="langmenu">
      <summary>{{ t.native }}</summary>
      <div class="panel">
        <ul>{% for o in langs %}{% if o.code == code %}<li><span lang="{{ o.code }}">{{ o.native }}</span></li>{% else %}<li><a href="../{{ o.code }}/" lang="{{ o.code }}" hreflang="{{ o.code }}">{{ o.native }}</a></li>{% endif %}{% endfor %}</ul>
        <a class="req" href="{{ request_mailto }}">{{ t.request }}</a>
      </div>
    </details></nav>
  {% if t.mt_notice %}<p class="mt">{{ t.mt_notice }}</p>{% endif %}
  <header>
    <h1>{{ h1 }}</h1>
    <p class="alt" lang="{{ alt_lang }}">{{ alt_name }}</p>
    <p class="role">{{ t.role }}</p>
    <p class="tagline" lang="{{ code }}">{{ t.tagline }}</p>
    <p class="buttons"><a class="btn" href="mailto:{{ site.email }}">{{ t.btn_email }}</a><a class="btn ghost" href="{{ site.github }}">{{ t.btn_github }}</a></p>
  </header>
  <section class="kw">
    <h2>{{ t.keywords_h }}</h2>
    <ul class="keywords">{% for k in site.keywords %}<li>{{ t.keywords[k] }}</li>{% endfor %}</ul>
  </section>
{% if talks %}  <section class="talks"><div class="carousel">{% for x in talks %}<a class="talk"{% if x.url %} href="{{ x.url }}"{% endif %}><span class="meta">{{ x.date }} / {{ x.venue }}</span><strong>{{ x.title }}</strong></a>{% endfor %}</div></section>
{% endif %}

  <section lang="{{ code }}">
    <h2>{{ t.interests_h }}</h2>
    <ul>{% for x in t.interests %}<li>{{ x }}</li>{% endfor %}</ul>
    <h3>{{ t.current_h }}</h3>
    <p>{{ t.current }}</p>
  </section>

  <section>
    <h2>{{ t.pubs_h }}</h2>
    <p class="empty">{{ t.soon }}</p>
  </section>

  <section lang="{{ code }}">
    <h2>{{ t.projects_h }}</h2>
    <ul>{% for p in t.projects %}<li><strong>{{ p.name }}</strong>: {{ p.desc }}</li>{% endfor %}</ul>
  </section>

  <section>
    <h2>{{ t.edu_h }}</h2>
    <ul>
      <li>{{ t.edu }}<br>
        <span class="meta">{{ t.thesis }}: <bdi dir="auto" lang="{{ thesis_lang }}">{{ thesis_title }}</bdi> {{ t.unpublished }}</span></li>
    </ul>
  </section>

  <section lang="{{ code }}">
    <h2>{{ t.langs_h }}</h2>
    <p>{{ t.langs }}</p>
  </section>

  <section>
    <h2>{{ t.contact_h }}</h2>
    <dl class="contact">
      <dt>{{ t.email }}</dt><dd><a href="mailto:{{ site.email }}" dir="ltr">{{ site.email }}</a></dd>
      <dt>GitHub</dt><dd><a href="{{ site.github }}" dir="ltr">{{ site.github | replace("https://", "") }}</a></dd>
    </dl>
  </section>

  <footer>{{ t.updated }}<br><small>&copy; {{ site.copyright_from }}– {{ footer_name }}</small></footer>
</main>
<script src="../lang.js"></script>
<script data-goatcounter="{{ site.goatcounter }}" async src="https://gc.zgo.at/count.js"></script>
</body>
</html>
