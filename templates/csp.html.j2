{#- The Content-Security-Policy of every page that loads GoatCounter (.claude/rules/security.md).
    The GoatCounter origin is taken from `goatcounter` in data/site.yaml by tools/build.py. -#}
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self' https://gc.zgo.at; img-src 'self' {{ goatcounter_origin }}; connect-src 'self' {{ goatcounter_origin }}; form-action 'none'; base-uri 'none'; object-src 'none'">