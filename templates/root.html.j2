<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta http-equiv="Content-Security-Policy" content="default-src 'none'; style-src 'self'; script-src 'self'; img-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ site.name.latin }}</title>
<link rel="canonical" href="{{ site.url }}/">
{% for o in langs %}<link rel="alternate" hreflang="{{ o.code }}" href="{{ site.url }}/{{ o.code }}/">
{% endfor %}<link rel="alternate" hreflang="x-default" href="{{ site.url }}/">
<link rel="stylesheet" href="style.css">
<script src="redirect.js" data-langs="{{ langs | map(attribute='code') | join(' ') }}"></script>
</head>
<body>
<main>
  <h1>{{ site.name.latin }}</h1>
  <p class="alt" lang="ja">{{ site.name.ja }}</p>
  <ul class="chooser">{% for o in langs %}<li><a href="{{ o.code }}/" lang="{{ o.code }}" hreflang="{{ o.code }}">{{ o.native }}</a></li>{% endfor %}</ul>
</main>
</body>
</html>
