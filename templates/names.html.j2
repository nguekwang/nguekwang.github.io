{#- The institution-names page, /<lang>/institution-names/. Layout: subpage.html.j2. -#}
{% extends "subpage.html.j2" %}
{% block content %}  <h1 class="page-h">{{ t.names_h }}</h1>
  <p>{{ t.names_intro }}</p>
  <ul class="names">{% for r in rows %}
    <li><strong>{{ r.name }}</strong><br>
      {% if r.status == "official" %}{{ t.names_official }}<br><span class="meta">{{ t.names_source }}{{ t.colon }}<a href="{{ r.source }}" dir="ltr">{{ r.source | replace("https://", "") }}</a></span>
      {% else %}{{ t.names_translated }}<br><span class="meta">{{ t.names_basis }}{{ t.colon }}<bdi lang="{{ r.basis_lang }}">{{ r.basis_name }}</bdi></span>{% endif %}
    </li>{% endfor %}
  </ul>
{% endblock %}
