{#- Favicon links for every page. `up` is the relative path back to the site root.
    static/favicon-192.png is static/favicon.svg at 192 x 192: square and a multiple of
    48 px, as search engines want, and for browsers without SVG favicons. -#}
<link rel="icon" href="{{ up }}favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ up }}favicon-192.png" type="image/png" sizes="192x192">
<link rel="apple-touch-icon" href="{{ up }}favicon-192.png">
